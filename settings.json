{
    "workbench.colorTheme": "Tokyo Night Storm", // Tema de colores del editor
    "workbench.editor.showTabs": "none", // Oculta las pestañas del editor
    "workbench.statusBar.visible": false, // Oculta la barra de estado inferior
    "workbench.activityBar.location": "top", // Mueve la barra de actividades arriba
    "workbench.startupEditor": "none", // No abrir ningún editor al inicio
    "workbench.layoutControl.enabled": false, // Oculta el control de diseño de la interfaz
    "workbench.iconTheme": "material-icon-theme", // Tema de íconos para el explorador
    "workbench.productIconTheme": "fluent-icons", // Tema de íconos del producto (paneles, acciones)
    "workbench.sideBar.location": "right", // Mueve la barra lateral a la derecha
    "workbench.editor.empty.hint": "hidden", // Oculta sugerencias al no haber archivos abiertos
    "workbench.editor.editorActionsLocation": "titleBar", // Acciones del editor en la barra de título
    "window.zoomLevel": 0, // Nivel de zoom de la interfaz
    "window.titleBarStyle": "custom", // Usa barra de título personalizada
    "window.customTitleBarVisibility": "auto", // Muestra la barra de menú en modo compacto
    "window.confirmSaveUntitledWorkspace": false, // No preguntar al cerrar espacios de trabajo sin guardar
    "editor.scrollbar.vertical": "hidden", // Oculta barra de desplazamiento vertical
    "editor.overviewRulerBorder": false, // Oculta el borde de la regla general
    "editor.hideCursorInOverviewRuler": true, // Oculta el cursor en la regla de descripción general
    "editor.glyphMargin": false, // Oculta el margen de glifos (puntos de interrupción, etc.)
    "editor.minimap.enabled": false, // Desactiva el minimapa del editor
    "editor.stickyScroll.enabled": false, // Desactiva el encabezado fijo al hacer scroll
    "breadcrumbs.enabled": false, // Desactiva las migas de navegación (breadcrumbs)
    "explorer.compactFolders": false, // Muestra todas las carpetas completas en el explorador (no compacto)
    "explorer.confirmDragAndDrop": false, // Desactiva confirmación al arrastrar y soltar archivos
    "explorer.confirmDelete": false, // Desactiva confirmación al eliminar archivos
    "terminal.integrated.tabs.defaultIcon": "clear-all", // Icono por defecto para pestañas del terminal
    "terminal.integrated.defaultProfile.windows": "Git Bash", // Terminal predeterminado en Windows
    "editor.formatOnSave": true, // Formatea automáticamente al guardar
    "files.autoSave": "afterDelay", // Guarda automáticamente después de un pequeño retraso
    "editor.matchBrackets": "never", // Desactiva el resaltado de corchetes coincidentes
    "editor.cursorBlinking": "expand", // Estilo de parpadeo del cursor
    "editor.guides.bracketPairs": true, // Muestra guías de pares de corchetes
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true, // Colores distintos por tipo de corchete
    "telemetry.telemetryLevel": "off", // Desactiva la telemetría (envío de datos)
    "editor.cursorSmoothCaretAnimation": "on", // Suaviza la animación del cursor
    "editor.linkedEditing": true, // Edición enlazada de etiquetas o pares
    "editor.defaultFormatter": "esbenp.prettier-vscode", // Formato predeterminado: Prettier
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    }, // Prettier como formateador de JavaScript
    "color-highlight.markRuler": false, // Desactiva la regla de resaltado de colores
    "editor.fontFamily": "'JetBrains Mono', Consolas, 'Courier New', monospace", // Fuente personalizada para el editor
    "editor.fontWeight": "300", // Peso de fuente base (300 = Light)
    "editor.fontLigatures": true, // Activa ligaduras tipográficas (fuentes programáticas)
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": ["keyword", "storage.type", "storage.modifier"],
          "settings": {
            "fontStyle": "bold", // Usa Bold para palabras clave
          },
        },
        {
          "scope": ["entity.name.function", "support.function"],
          "settings": {
            "fontStyle": "", // Usa Regular (peso normal) para funciones
          },
        },
      ],
    },
    "claudeCode.preferredLocation": "panel",
    "update.releaseTrack": "prerelease",
    "window.menuBarVisibility": "compact",
  }
  